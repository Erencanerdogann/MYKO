/////////////////////////////////////////////////////////////////////////////
//
// S115 FAZ 5c — Self-Heal Diagnostik Dialog (Glasmorphism stil)
// Boyut 420x280, ferah layout, Segoe UI font, custom paint WM_CTLCOLORDLG
//

IDD_DIAGNOSTIC DIALOGEX 0, 0, 420, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_LAYERED
CAPTION "MalaysiaKO — Tani ve Onarim"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Ust baslik bandi
    LTEXT           "Bilgisayariniz tarandi.", IDC_STATIC, 16, 12, 388, 14, SS_NOTIFY
    LTEXT           "Sorun bulunan satira tiklayip, alt taraftaki Onarim butonuna basabilirsiniz.", IDC_STATIC, 16, 28, 388, 14

    // Sonuc listesi (ferah, font Consolas — monospace ikon)
    LISTBOX         IDC_DIAG_LIST, 16, 48, 388, 160, LBS_NOTIFY | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_BORDER

    // Status bar
    LTEXT           "Durum:", IDC_STATIC, 16, 214, 28, 10
    LTEXT           "Hazir.", IDC_DIAG_STATUS, 48, 214, 356, 10

    // Repair butonlari (Segoe UI ile, ferah)
    PUSHBUTTON      "Defender Onayla", IDC_DIAG_REPAIR_DEFENDER, 16, 234, 92, 22
    PUSHBUTTON      "VC++ Indir", IDC_DIAG_REPAIR_VCREDIST, 114, 234, 70, 22
    PUSHBUTTON      "Server.ini Sifirla", IDC_DIAG_REPAIR_SERVERINI, 190, 234, 86, 22
    PUSHBUTTON      "Yeniden Tara", IDC_DIAG_REFRESH, 282, 234, 70, 22
    DEFPUSHBUTTON   "Kapat", IDC_DIAG_CLOSE, 358, 234, 46, 22
END

