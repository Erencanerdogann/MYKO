/////////////////////////////////////////////////////////////////////////////
//
// S115 FAZ 5c — Self-Heal Diagnostik Dialog (Glasmorphism stil)
// Boyut 420x280, ferah layout, Segoe UI font, custom paint WM_CTLCOLORDLG
//

// Compact: 320x220 - Launcher 175x263 ile uyumlu (1.8 kati). Em-dash YASAK (encoding bozar).
IDD_DIAGNOSTIC DIALOGEX 0, 0, 320, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_LAYERED
CAPTION "MalaysiaKO - Tani ve Onarim"
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    // Ust baslik (tek satir, kisa)
    LTEXT           "Bilgisayariniz tarandi. Sorunlu satira tikla, alttan Onar.", IDC_STATIC, 10, 8, 300, 12

    // Sonuc listesi (kompakt)
    LISTBOX         IDC_DIAG_LIST, 10, 24, 300, 124, LBS_NOTIFY | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_BORDER

    // Status bar
    LTEXT           "Durum:", IDC_STATIC, 10, 154, 28, 10
    LTEXT           "Hazir.", IDC_DIAG_STATUS, 42, 154, 268, 10

    // Repair butonlari (kompakt, 4'lu satir + BS_OWNERDRAW: glasmorphism custom paint)
    PUSHBUTTON      "Defender", IDC_DIAG_REPAIR_DEFENDER, 10, 172, 56, 20, BS_OWNERDRAW
    PUSHBUTTON      "VC++ Indir", IDC_DIAG_REPAIR_VCREDIST, 70, 172, 56, 20, BS_OWNERDRAW
    PUSHBUTTON      "Server.ini", IDC_DIAG_REPAIR_SERVERINI, 130, 172, 56, 20, BS_OWNERDRAW
    PUSHBUTTON      "Tara", IDC_DIAG_REFRESH, 190, 172, 38, 20, BS_OWNERDRAW
    DEFPUSHBUTTON   "Kapat", IDC_DIAG_CLOSE, 270, 172, 40, 20, BS_OWNERDRAW

    // Refresh aciklama (kucuk)
    LTEXT           "Onar -> sorunu cozer  |  Tara -> tekrar kontrol et", IDC_STATIC, 10, 196, 300, 10
END

/////////////////////////////////////////////////////////////////////////////
//
// S115 v2.7+ — Basit Self-Heal Dialog (C plani: 1 buton ONAR)
// Connection failed sonrasi arka plan tarama ERROR bulursa otomatik acilir.
// Kullanici sadece sorunu gorur ve ONAR'a basar — arka planda tum repair'lar
// sirayla calistirilir (Defender + VCRedist + Server.ini).
//

IDD_DIAGNOSTIC_SIMPLE DIALOGEX 0, 0, 240, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MalaysiaKO - Sorun bulundu"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Bilgisayarinizda bir sorun var:", IDC_STATIC, 12, 10, 216, 12
    LTEXT           "", IDC_DIAG_S_PROBLEMS, 12, 26, 216, 60
    DEFPUSHBUTTON   "ONAR", IDC_DIAG_S_ONAR, 90, 96, 60, 24
    PUSHBUTTON      "Kapat", IDC_DIAG_S_CLOSE, 184, 120, 44, 14
END

